# PostgreSQL connection (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hukm?schema=public"

# NextAuth (required) - generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Hukm AI assistant: each firm saves its own Claude API key from
# /admin/hukm/settings. Keys are encrypted with this secret (falls back to a key
# derived from NEXTAUTH_SECRET). Changing it makes saved keys unreadable.
AI_KEY_SECRET=""

# Embedding model (Arabic-capable) - used in later phases
EMBEDDING_MODEL=""
EMBEDDING_API_KEY=""

# File storage (S3-compatible) - used in later phases
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Notifications (Phase 1: in-app only; email/SMS/WhatsApp later)
SMTP_URL=""
SMS_API_KEY=""
WHATSAPP_TOKEN=""

# OCR provider - used in later phases
OCR_PROVIDER=""
OCR_API_KEY=""

# Public «حُكم» robot on the platform home page (optional). Firm sites use the
# firm's own key. Without a key the robot still offers its quick links.
HUKM_PUBLIC_API_KEY=""
HUKM_PUBLIC_MODEL=""
# Leave empty for Claude; set for an OpenAI-compatible provider
HUKM_PUBLIC_BASE_URL=""
