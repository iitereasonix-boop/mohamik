// Mohamik – multi-tenant foundation
// Every tenant-scoped table carries tenant_id. Row-Level Security (RLS)
// policies are applied via SQL migration (see prisma/rls.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum PlatformRole {
  SUPER_ADMIN
  LEGAL_EDITOR
  SUPPORT
  FINANCE
}

enum TenantRole {
  MANAGING_PARTNER
  LAWYER
  TRAINEE
  SECRETARY
  ACCOUNTANT
}

enum TenantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PlanTier {
  SOLO
  FIRM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserKind {
  PLATFORM
  TENANT
  CLIENT
}

enum CaseType {
  CRIMINAL
  CIVIL
  COMMERCIAL
  LABOUR
  FAMILY
  REAL_ESTATE
  COMPANIES
  CYBERCRIME
  ENFORCEMENT
  OTHER
}

enum CaseStage {
  PRE_LITIGATION
  FIRST_INSTANCE
  APPEAL
  CASSATION
  ENFORCEMENT
}

enum CaseStatus {
  INTAKE_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED_WON
  CLOSED_LOST
  CLOSED_SETTLED
  CLOSED_OTHER
}

enum ClientRoleInCase {
  PLAINTIFF
  DEFENDANT
  COMPLAINANT
  ACCUSED
  OTHER
}

enum HearingPurpose {
  FIRST_SESSION
  PLEADINGS
  EVIDENCE
  ARGUMENTS
  JUDGMENT
  OTHER
}

enum DeadlineKind {
  APPEAL
  OBJECTION
  DOCUMENT_SUBMISSION
  LIMITATION_PERIOD
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum AppointmentKind {
  IN_OFFICE
  PHONE
  VIDEO
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum IntakeStatus {
  NEW
  UNDER_REVIEW
  MORE_INFO_REQUESTED
  ACCEPTED
  DECLINED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum DocumentFolder {
  PLEADINGS
  EVIDENCE
  COURT_DECISIONS
  CORRESPONDENCE
  IDS
  OTHER
}

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  DOWNLOAD
  SHARE
  LOGIN
  LOGOUT
  AI_ACCESS
}

// ─────────────────────────── Platform level ───────────────────────────

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  platformRole PlatformRole
  twoFactorEn  Boolean      @default(false)
  twoFactorSec String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  auditLogs    AuditLog[]
}

model Plan {
  id              String         @id @default(cuid())
  tier            PlanTier       @unique
  nameAr          String
  nameEn          String
  maxLawyers      Int
  maxStorageGb    Int
  monthlyAiCalls  Int
  monthlyPriceJod Decimal        @db.Decimal(10, 2)
  monthlyPriceUsd Decimal        @db.Decimal(10, 2)
  features        Json?
  active          Boolean        @default(true)
  subscriptions   Subscription[]
}

// ─────────────────────────── Tenant (law firm) ───────────────────────────

model Tenant {
  id                String       @id @default(cuid())
  name              String
  subdomain         String       @unique
  customDomain      String?      @unique
  status            TenantStatus @default(PENDING_VERIFICATION)
  barNumber         String // Jordan Bar Association membership no. of owner
  commercialReg     String?
  address           String?
  phone             String?
  email             String?
  practiceAreas     CaseType[]
  demo              Boolean      @default(false)
  // branding (within the shared design system)
  logoUrl           String?
  accentColor       String?
  siteCoverImageUrl String?
  portalBackgroundUrl String? // header background of the client portal
  siteTagline       String?
  siteAbout         String?
  // onboarding
  onboardingStep    Int          @default(0)
  setupChecklist    Json?
  // settings
  workingHours      Json?
  appointmentRules  Json?
  notifTemplates    Json?
  dataRetentionDays Int          @default(3650)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users           User[]
  clients         Client[]
  cases           Case[]
  appointments    Appointment[]
  intakeRequests  IntakeRequest[]
  documents       Document[]
  tasks           Task[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  notes           CaseNote[]
  clientUpdates   ClientUpdate[]
  assets          TenantAsset[]
  aiSettings      AiSettings?
  knowledgeDocs   KnowledgeDoc[]
  aiConversations AiConversation[]
  consultRequests ConsultRequest[]
  subscription    Subscription?
}

model Subscription {
  id           String             @id @default(cuid())
  tenantId     String             @unique
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIALING)
  trialEndsAt  DateTime?
  currentStart DateTime
  currentEnd   DateTime
  usage        Json? // AI calls, OCR pages, storage used
  createdAt    DateTime           @default(now())
}

// ─────────────────────────── Users (staff + clients) ───────────────────────────
// One users table with kind discriminator; tenantId null for platform users.

model User {
  id            String      @id @default(cuid())
  kind          UserKind
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  email         String
  passwordHash  String
  name          String
  mobile        String?
  nationalIdEnc String? // encrypted at rest
  tenantRole    TenantRole?
  twoFactorEn   Boolean     @default(false)
  twoFactorSec  String?
  avatarUrl     String?
  active        Boolean     @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  clientProfile Client?        @relation("clientUser")
  assignedCases Case[]         @relation("assignedLawyers")
  appointments  Appointment[]  @relation("staffAppointments")
  tasksAssigned Task[]         @relation("assignee")
  auditLogs     AuditLog[]
  notifications Notification[]
  notes         CaseNote[]

  @@unique([tenantId, email])
}

model Client {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  userId        String?   @unique
  user          User?     @relation("clientUser", fields: [userId], references: [id])
  name          String
  mobile        String
  email         String?
  nationalIdEnc String? // encrypted at rest
  source        String?
  notes         String?
  consentAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cases           Case[]
  appointments    Appointment[]
  documents       Document[]
  messages        ClientMessage[]
  consultRequests ConsultRequest[]

  @@unique([tenantId, mobile])
  @@index([tenantId, name])
}

// ─────────────────────────── Cases ───────────────────────────

model Case {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  internalNumber  String
  courtNumber     String?
  title           String
  type            CaseType
  stage           CaseStage        @default(PRE_LITIGATION)
  status          CaseStatus       @default(INTAKE_REVIEW)
  court           String?
  chamber         String?
  judge           String?
  clientRole      ClientRoleInCase
  opposingParties Json? // [{name, counsel}]
  claimValue      Decimal?         @db.Decimal(14, 2)
  clientSummary   String? // client's own submission (facts)
  lawyerFacts     Json? // structured facts, each linked to a source doc
  outcome         Json? // result, ruling summary, lessons (on closing)
  closedAt        DateTime?
  demo            Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  lawyers       User[]          @relation("assignedLawyers")
  hearings      Hearing[]
  deadlines     Deadline[]
  documents     Document[]
  tasks         Task[]
  timeline      TimelineEvent[]
  notes         CaseNote[]
  clientUpdates ClientUpdate[]

  @@unique([tenantId, internalNumber])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
}

model TimelineEvent {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  kind            String // filing / hearing / adjournment / ruling / appeal / note
  title           String
  description     String?
  eventDate       DateTime
  visibleToClient Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([caseId, eventDate])
}

model Hearing {
  id              String         @id @default(cuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id])
  date            DateTime
  court           String
  room            String?
  purpose         HearingPurpose
  outcome         String?
  nextDate        DateTime?
  visibleToClient Boolean        @default(true)
  createdByUserId String?
  createdAt       DateTime       @default(now())

  @@index([caseId, date])
}

model Deadline {
  id                String       @id @default(cuid())
  caseId            String
  case              Case         @relation(fields: [caseId], references: [id])
  kind              DeadlineKind
  dueDate           DateTime
  description       String
  legalBasis        String? // law + article from the library (Phase 3 links it properly)
  confirmedByUserId String?
  completed         Boolean      @default(false)
  createdAt         DateTime     @default(now())

  @@index([caseId, dueDate])
}

model Document {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  caseId           String?
  case             Case?          @relation(fields: [caseId], references: [id])
  clientId         String?
  client           Client?        @relation(fields: [clientId], references: [id])
  folder           DocumentFolder
  title            String
  storageKey       String // tenant-scoped storage prefix
  mimeType         String
  sizeBytes        Int
  version          Int            @default(1)
  ocrText          String?
  ocrConfidence    Float?
  tags             String[]
  visibleToClient  Boolean        @default(false)
  uploadedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId, caseId])
}

model Task {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  caseId      String?
  case        Case?      @relation(fields: [caseId], references: [id])
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?      @relation("assignee", fields: [assigneeId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, status])
}

// ─────────────────────────── Appointments ───────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  kind        AppointmentKind
  status      AppointmentStatus @default(SCHEDULED)
  startAt     DateTime
  durationMin Int               @default(30)
  notes       String?
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id])
  staffId     String?
  staff       User?             @relation("staffAppointments", fields: [staffId], references: [id])
  caseId      String?
  createdAt   DateTime          @default(now())

  @@index([tenantId, startAt])
}

// ─────────────────────────── Intake & communication ───────────────────────────

model IntakeRequest {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  status           IntakeStatus @default(NEW)
  caseType         CaseType
  description      String
  parties          Json?
  courtCaseNumber  String?
  urgency          String?
  preferredContact String?
  conflictCheck    Json? // result of the conflict-of-interest check
  reviewNotes      String?
  createdCaseId    String?
  createdAt        DateTime     @default(now())
  reviewedAt       DateTime?

  @@index([tenantId, status])
}

// Consultation request submitted via the firm's client portal.
// Reviewed in the intake inbox; on acceptance it becomes a Case.
model ConsultRequest {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  subject     String
  details     String
  caseType    String?
  status      String   @default("NEW") // NEW / UNDER_REVIEW / ACCEPTED / DECLINED
  reviewNotes String?
  createdAt   DateTime @default(now())

  @@index([tenantId, status])
}

model ClientMessage {
  id          String   @id @default(cuid())
  tenantId    String
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  caseId      String?
  fromClient  Boolean
  body        String
  readByStaff Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, clientId])
}

model ClientUpdate {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  caseId           String
  case             Case                  @relation(fields: [caseId], references: [id])
  body             String
  approved         Boolean               @default(false)
  approvedByUserId String?
  sentAt           DateTime?
  channels         NotificationChannel[]
  createdByUserId  String?
  createdAt        DateTime              @default(now())
}

// ─────────────────────────── Notes & audit ───────────────────────────

model CaseNote {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  body            String
  mentions        String[] // user ids
  // never visible to clients — enforced at query level
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([caseId])
}

model Notification {
  id        String              @id @default(cuid())
  tenantId  String?
  tenant    Tenant?             @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  platformUserId String?
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id])
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         AuditAction
  entityType     String
  entityId       String?
  detail         Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

// Images a firm uploads from its own device (logo, cover). Stored in the
// database so they survive redeploys; served by /api/f/[subdomain]/assets/[id].
model TenantAsset {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String // LOGO / COVER
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([tenantId, kind])
}

// ───────────── «حُكم» — the firm's AI assistant ─────────────

// One per firm. The API key is stored encrypted (AES-256-GCM) and never sent
// back to the browser; only the last 4 characters are shown.
model AiSettings {
  tenantId        String    @id
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String    @default("anthropic")
  baseUrl         String?
  model           String    @default("claude-opus-5-5")
  apiKeyEnc       String
  apiKeyLast4     String
  enabled         Boolean   @default(true)
  verifiedAt      DateTime?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// The firm's own library: laws, past rulings / precedents and internal
// references. Split into chunks (one per article where possible) for search.
model KnowledgeDoc {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind            String // LAW / PRECEDENT / REFERENCE
  title           String
  reference       String? // e.g. "قانون العمل رقم 8 لسنة 1996"
  jurisdiction    String           @default("الأردن")
  content         String
  chunkCount      Int              @default(0)
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  chunks          KnowledgeChunk[]

  @@index([tenantId, kind])
}

model KnowledgeChunk {
  id       String       @id @default(cuid())
  tenantId String
  docId    String
  doc      KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  idx      Int
  heading  String? // e.g. "المادة 23"
  text     String
  norm     String // normalized Arabic for search

  @@index([tenantId])
  @@index([docId, idx])
}

model AiConversation {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  attachments AiAttachment[]

  @@index([tenantId, userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user / assistant
  content        String
  sources        Json? // { [ref]: {type,label,sub,excerpt} } verified against tool output
  unverified     String[] // refs the model cited that no tool returned
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ───────────── Public Jordanian law library (platform-wide, read by everyone) ─────────────
// Text is added by platform admins from official sources; an entry without
// articles is a catalogue listing only.
model PublicLaw {
  id           String             @id @default(cuid())
  category     String
  title        String             @unique
  number       Int?
  year         Int?
  summary      String?
  sourceUrl    String?
  content      String             @default("")
  articleCount Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  articles     PublicLawArticle[]

  @@index([category])
}

model PublicLawArticle {
  id      String    @id @default(cuid())
  lawId   String
  law     PublicLaw @relation(fields: [lawId], references: [id], onDelete: Cascade)
  idx     Int
  heading String?
  text    String
  norm    String

  @@index([lawId, idx])
}

// Files and images a user uploads into a «حُكم» conversation, kept as text.
model AiAttachment {
  id             String         @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  fileName       String
  mimeType       String
  text           String
  charCount      Int
  viaVision      Boolean        @default(false) // text read from an image by the AI model
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}
